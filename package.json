{
  "name": "anki-akshay-reviewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:n": "vite --host",
    "dev:all": "run-p dev backend:watch",
    "start": "pnpm run backend",
    "backend": "node --env-file=.env --import tsx proxy/index.ts",
    "backend:watch": "nodemon --watch proxy --watch dist --ext ts,js,json --exec \"node --env-file=.env --import tsx\" proxy/index.ts",
    "proxy": "tsx proxy/index.ts",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/ --write"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.0",
    "@tiptap/extension-placeholder": "^3.20.5",
    "@tiptap/extension-table": "^3.20.5",
    "@tiptap/extension-table-cell": "^3.20.5",
    "@tiptap/extension-table-header": "^3.20.5",
    "@tiptap/extension-table-row": "^3.20.5",
    "@tiptap/extension-underline": "^3.20.5",
    "@tiptap/pm": "^3.20.5",
    "@tiptap/starter-kit": "^3.20.5",
    "@tiptap/vue-3": "^3.20.5",
    "@types/marked": "^6.0.0",
    "dotenv": "^16.4.7",
    "hono": "^4.12.5",
    "http-proxy-middleware": "^3.0.5",
    "install": "^0.13.0",
    "marked": "^17.0.5",
    "pinia": "^3.0.4",
    "pino": "^10.3.1",
    "ts-fsrs": "^5.3.1",
    "tsx": "^4.21.0",
    "turndown": "^7.2.4",
    "vue": "^3.5.28",
    "vue-router": "^5.0.2"
  },
  "pnpm": {
    "overrides": {
      "quill": "^2.0.3"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.13",
    "@types/pino": "^7.0.5",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitejs/plugin-vue-jsx": "^5.1.4",
    "@vitest/eslint-plugin": "^1.6.9",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "daisyui": "^5.5.19",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.46.0",
    "eslint-plugin-playwright": "^2.5.1",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^28.1.0",
    "less": "^4.5.1",
    "nodemon": "^3.1.14",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.32.0",
    "oxlint": "~1.47.0",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}